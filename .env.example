NODE_ENV=development
TENANT_ID=11111111-1111-4111-8111-111111111111
# Optional CLI account selector; must belong to TENANT_ID. Never used in production.
# DEVELOPMENT_SUBSCRIPTION_ID=22222222-2222-4222-8222-222222222222
TOKEN_AUDIENCE=api://YOUR-GATEWAY-APPLICATION-ID
REQUIRED_SCOPE=Gateway.Invoke
UPSTREAM_MODE=native
UPSTREAM_BASE_URL=https://YOUR-GATEWAY.azure-api.net/default/models/anthropic
LOCAL_SQLITE_PATH=.local/gateway.db
POLICY_FILE=config/policy.example.json
GRAPH_CACHE_SECONDS=0
PORT=8080
# Production requires PostgreSQL and managed identity; never commit its URL.
# DATABASE_URL=postgresql://...?...sslmode=verify-full
